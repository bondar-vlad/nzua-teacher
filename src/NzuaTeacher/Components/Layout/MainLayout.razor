@inherits LayoutComponentBase
@using NzuaTeacher.Services
@inject NzuaSessionService Session
@inject OutboxService Outbox
@implements IDisposable

<div class="page">
    <aside class="sidebar">
        <div class="brand">
            <span class="brand-icon">📓</span>
            <span class="brand-name">НЗ Вчитель</span>
        </div>

        <nav class="nav">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All"><span>🏠</span> Журнали</NavLink>
            <NavLink class="nav-link" href="sync">
                <span>🔄</span> Синхронізація
                @if (_pendingCount > 0)
                {
                    <span class="badge">@_pendingCount</span>
                }
            </NavLink>
            <NavLink class="nav-link" href="chat"><span>🤖</span> AI-помічник</NavLink>
            <NavLink class="nav-link" href="generator"><span>📝</span> Генератор робіт</NavLink>
            <NavLink class="nav-link" href="assets"><span>📚</span> Мої матеріали</NavLink>
            <NavLink class="nav-link" href="settings"><span>⚙️</span> Налаштування</NavLink>
        </nav>

        <div class="session-status @(Session.HasSession ? "online" : "offline")">
            @if (Session.HasSession)
            {
                <span class="dot"></span>
                <span>NZ.UA: сесія активна</span>
            }
            else
            {
                <span class="dot"></span>
                <span>NZ.UA: не під'єднано</span>
            }
        </div>
    </aside>

    <main class="content">
        <ErrorBoundary @ref="_errorBoundary" @key="_boundaryKey">
            <ChildContent>@Body</ChildContent>
            <ErrorContent Context="exception">
                <div class="card" style="max-width:760px">
                    <h2>⚠️ Сталася помилка на цій сторінці</h2>
                    <div class="alert error" style="margin-top:10px">@exception.Message</div>
                    <details>
                        <summary class="subtitle" style="cursor:pointer">Технічні подробиці (для звіту про помилку)</summary>
                        <pre style="white-space:pre-wrap; font-size:.75rem; max-height:260px; overflow:auto">@exception</pre>
                    </details>
                    <div style="display:flex; gap:8px; margin-top:12px; flex-wrap:wrap">
                        <button class="btn primary" @onclick="Recover">↺ Спробувати ще раз</button>
                        <button class="btn" @onclick="OpenLogFolder">📁 Відкрити журнал помилок</button>
                    </div>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </main>
</div>

@code {
    private int _pendingCount;
    private ErrorBoundary? _errorBoundary;
    private int _boundaryKey;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnChanged;
        Outbox.Changed += OnChanged;
        _pendingCount = await Outbox.GetPendingCountAsync();
    }

    private void Recover()
    {
        // Новий @key перестворює межу разом із дочірньою сторінкою.
        _boundaryKey++;
        _errorBoundary?.Recover();
    }

    private async Task OpenLogFolder()
    {
        try
        {
            await Launcher.Default.OpenAsync(new Uri("file:///" + FileLoggerProvider.LogDirectory.Replace('\\', '/')));
        }
        catch
        {
            // якщо не вдалося — шлях все одно видно в подробицях
        }
    }

    private async void OnChanged()
    {
        try
        {
            _pendingCount = await Outbox.GetPendingCountAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            FileLoggerProvider.Write("MainLayout", "Не вдалося оновити лічильник змін", ex);
        }
    }

    public void Dispose()
    {
        Session.Changed -= OnChanged;
        Outbox.Changed -= OnChanged;
    }
}
