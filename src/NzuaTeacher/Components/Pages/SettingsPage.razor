@page "/settings"
@using Microsoft.Extensions.AI
@inject NzuaSessionService Session
@inject AiSettingsService AiSettings
@inject Microsoft.EntityFrameworkCore.IDbContextFactory<TeacherDbContext> DbFactory

<div class="page-header">
    <div>
        <h1>Налаштування</h1>
    </div>
</div>

@if (_notice is not null)
{
    <div class="alert @_noticeClass">@_notice <button class="btn-icon" @onclick="() => _notice = null">✕</button></div>
}

<div class="settings-grid">

    <div class="card">
        <h2>🔐 Вхід у NZ.UA</h2>
        @if (Session.HasSession)
        {
            <p>Ви увійшли в NZ.UA.
                @if (Session.ExpiresAt is { } exp)
                {
                    <span class="subtitle">Сесія дійсна до @exp.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                }
            </p>
            <button class="btn danger" @onclick="Logout">Вийти</button>
        }
        else
        {
            <p class="subtitle">
                Вхід відбувається у справжньому вікні браузера — пароль у застосунку не зберігається.
            </p>
            <button class="btn primary" @onclick="Login" disabled="@_loggingIn">
                @if (_loggingIn)
                {
                    <span class="spinner"></span>
                }
                Увійти в NZ.UA
            </button>
        }
    </div>

    @foreach (var provider in Enum.GetValues<AiProvider>())
    {
        <div class="card provider-card @(AiSettings.ActiveProvider == provider ? "active-provider" : "")">
            <h2>@ProviderIcon(provider) @AiSettingsService.ProviderNames[provider]</h2>

            <div class="key-help">
                @if (provider == AiProvider.Gemini)
                {
                    <text>1. Натисніть «Отримати ключ» — відкриється Google AI Studio.<br />
                    2. Увійдіть Google-акаунтом → кнопка <b>Create API key</b>.<br />
                    3. Скопіюйте ключ і вставте в поле нижче. Картка не потрібна — Flash-моделі мають безоплатний тариф
                    (Google може використовувати такі запити для покращення моделей, тому імена учнів ми замінюємо псевдонімами).</text>
                }
                else if (provider == AiProvider.OpenAi)
                {
                    <text>1. Натисніть «Отримати ключ» — відкриється platform.openai.com.<br />
                    2. Увійдіть → <b>Create new secret key</b> → скопіюйте ключ (показується один раз).<br />
                    3. Безоплатного тарифу немає: потрібно поповнити баланс (Billing) хоча б на кілька доларів.</text>
                }
                else
                {
                    <text>1. Натисніть «Отримати ключ» — відкриється console.anthropic.com.<br />
                    2. Увійдіть → <b>Create Key</b> → скопіюйте ключ.<br />
                    3. Безоплатного тарифу немає: потрібно поповнити баланс у розділі Billing.</text>
                }
            </div>
            <button class="btn small" @onclick="() => OpenKeyPage(provider)">🔗 Отримати ключ (@KeyHost(provider))</button>

            <div class="field" style="margin-top:12px">
                <label>API-ключ @(_hasKey[provider] ? "— збережено ✓" : "")</label>
                <div class="key-row">
                    <input type="password" @bind="_keyInputs[provider]"
                           placeholder="@(_hasKey[provider] ? "•••••••• (вставте новий, щоб замінити)" : "вставте скопійований ключ…")" />
                    <button class="btn" @onclick="() => SaveKey(provider)">Зберегти</button>
                </div>
            </div>

            <div class="field">
                <label>Модель</label>
                <select value="@ModelSelectValue(provider)" @onchange="@(e => OnModelSelected(provider, e.Value?.ToString() ?? string.Empty))">
                    @foreach (var (id, label) in AiSettingsService.KnownModels[provider])
                    {
                        <option value="@id">@label</option>
                    }
                    @if (!AiSettingsService.KnownModels[provider].Any(m => m.Id == AiSettings.GetModel(provider)))
                    {
                        <option value="@AiSettings.GetModel(provider)">@AiSettings.GetModel(provider) (власна)</option>
                    }
                    <option value="__custom">Інша модель (ввести вручну)…</option>
                </select>
                @if (_customModelFor == provider)
                {
                    <div class="key-row" style="margin-top:6px">
                        <input type="text" @bind="_customModelInput" placeholder="напр., gemini-3.6-flash" />
                        <button class="btn" @onclick="() => SaveCustomModel(provider)">OK</button>
                    </div>
                }
            </div>

            <div style="display:flex; gap:8px; flex-wrap:wrap">
                <button class="btn small @(AiSettings.ActiveProvider == provider ? "primary" : "")"
                        @onclick="() => SetActive(provider)">
                    @(AiSettings.ActiveProvider == provider ? "✓ Використовується" : "Використовувати цей")
                </button>
                <button class="btn small" @onclick="() => TestKey(provider)" disabled="@(_testing || !_hasKey[provider])">
                    @if (_testing)
                    {
                        <span class="spinner"></span>
                    }
                    Перевірити ключ
                </button>
                @if (_hasKey[provider])
                {
                    <button class="btn small danger" @onclick="() => RemoveKey(provider)">Видалити ключ</button>
                }
            </div>
        </div>
    }

    <div class="card">
        <h2>💬 Чат</h2>
        <div class="field">
            <label>Як надсилати повідомлення</label>
            <select @bind="_sendOnEnter" @bind:after="SaveSendOnEnter">
                <option value="true">Enter — надіслати, Shift+Enter — новий рядок</option>
                <option value="false">Ctrl+Enter — надіслати, Enter — новий рядок</option>
            </select>
        </div>
    </div>

    <div class="card">
        <h2>🎤 Голосовий ввід</h2>
        <p class="subtitle">Перетворення сказаного на текст у чаті. Потрібен ключ Gemini (безоплатно) або OpenAI.</p>
        <div class="field">
            <label>Сервіс розпізнавання</label>
            <select @bind="_transcriptionProvider" @bind:after="SaveTranscription">
                <option value="@AiProvider.Gemini">Gemini (безоплатний тариф)</option>
                <option value="@AiProvider.OpenAi">OpenAI Whisper (платно)</option>
            </select>
        </div>
    </div>

    <div class="card">
        <h2>🛡 Приватність</h2>
        <label class="checkbox-row">
            <input type="checkbox" checked="@_showRealNames" @onchange="ToggleRealNames" />
            Надсилати AI реальні імена учнів
        </label>
        <p class="subtitle">
            Вимкнено (рекомендовано): AI бачить стабільні псевдоніми «Учень-XXXXX»,
            а застосунок сам показує вам реальні імена. Ввімкнення передає ПІБ учнів хмарному провайдеру.
        </p>
    </div>

    <div class="card">
        <h2>💾 Дані на цьому компʼютері</h2>
        <p class="subtitle">
            Журнали, оцінки й теми зберігаються локально, щоб працювати без інтернету.<br />
            Розташування: @NzuaTeacher.Core.AppPaths.DataDir<br />
            Обсяг збережених даних: <b>@_dbSize</b>
        </p>
        <button class="btn danger" @onclick="() => _clearCacheVisible = true">Видалити збережені журнали</button>
    </div>

</div>

<Modal Visible="_clearCacheVisible" VisibleChanged="v => _clearCacheVisible = v" Title="Видалити збережені журнали?">
    <p>Буде видалено локальні копії журналів, оцінок і тем. <b>Ненадіслані зміни теж буде втрачено.</b></p>
    <p>Створені матеріали та налаштування залишаться. Дані можна завантажити з NZ.UA знову.</p>
    <div style="display:flex; justify-content:flex-end; gap:8px">
        <button class="btn" @onclick="() => _clearCacheVisible = false">Скасувати</button>
        <button class="btn danger" @onclick="ClearCache">Видалити</button>
    </div>
</Modal>

@code {
    // Заповнюємо одразу: перший рендер відбувається до завершення OnInitializedAsync.
    private readonly Dictionary<AiProvider, string> _keyInputs =
        Enum.GetValues<AiProvider>().ToDictionary(p => p, _ => "");
    private readonly Dictionary<AiProvider, bool> _hasKey =
        Enum.GetValues<AiProvider>().ToDictionary(p => p, _ => false);
    private AiProvider? _customModelFor;
    private string _customModelInput = "";
    private string _transcriptionProvider = "";
    private bool _showRealNames;
    private string _sendOnEnter = "true";
    private bool _loggingIn;
    private bool _testing;
    private bool _clearCacheVisible;
    private string? _notice;
    private string _noticeClass = "ok";
    private string _dbSize = "—";

    protected override async Task OnInitializedAsync()
    {
        foreach (var p in Enum.GetValues<AiProvider>())
            _hasKey[p] = !string.IsNullOrEmpty(await AiSettings.GetApiKeyAsync(p));

        _transcriptionProvider = AiSettings.TranscriptionProvider.ToString();
        _showRealNames = AiSettings.ShowRealNamesInChat;
        _sendOnEnter = AiSettings.SendOnEnter ? "true" : "false";
        _dbSize = GetDbSize();
    }

    private async Task Login()
    {
        _loggingIn = true;
        StateHasChanged();
        try
        {
            await Session.LoginAsync();
            Notify("Вхід виконано.", "ok");
        }
        catch (Exception ex)
        {
            Notify($"Не вдалося увійти: {ex.Message}", "error");
        }
        finally
        {
            _loggingIn = false;
        }
    }

    private void Logout()
    {
        Session.Logout();
        Notify("Ви вийшли з NZ.UA.", "ok");
    }

    private async Task OpenKeyPage(AiProvider provider)
    {
        try
        {
            await Launcher.Default.OpenAsync(AiSettingsService.KeyPageUrls[provider]);
        }
        catch (Exception ex)
        {
            Notify($"Не вдалося відкрити браузер: {ex.Message}. Адреса: {AiSettingsService.KeyPageUrls[provider]}", "warn");
        }
    }

    private static string KeyHost(AiProvider provider) =>
        new Uri(AiSettingsService.KeyPageUrls[provider]).Host;

    private async Task SaveKey(AiProvider provider)
    {
        var key = _keyInputs[provider];
        if (string.IsNullOrWhiteSpace(key))
        {
            Notify("Спершу вставте ключ у поле.", "warn");
            return;
        }
        await AiSettings.SetApiKeyAsync(provider, key);
        _keyInputs[provider] = "";
        _hasKey[provider] = true;
        Notify("Ключ збережено в захищеному сховищі Windows. Натисніть «Перевірити ключ», щоб упевнитися.", "ok");
    }

    private string ModelSelectValue(AiProvider provider) =>
        _customModelFor == provider ? "__custom" : AiSettings.GetModel(provider);

    private void OnModelSelected(AiProvider provider, string value)
    {
        if (value == "__custom")
        {
            _customModelFor = provider;
            _customModelInput = AiSettings.GetModel(provider);
            return;
        }
        _customModelFor = null;
        AiSettings.SetModel(provider, value);
        Notify($"Модель: {value}.", "ok");
    }

    private void SaveCustomModel(AiProvider provider)
    {
        if (string.IsNullOrWhiteSpace(_customModelInput)) return;
        AiSettings.SetModel(provider, _customModelInput);
        _customModelFor = null;
        Notify($"Модель: {AiSettings.GetModel(provider)}.", "ok");
    }

    private void SetActive(AiProvider provider)
    {
        AiSettings.ActiveProvider = provider;
        Notify($"Тепер використовується {AiSettingsService.ProviderNames[provider]}.", "ok");
    }

    private void RemoveKey(AiProvider provider)
    {
        AiSettings.RemoveApiKey(provider);
        _hasKey[provider] = false;
        Notify("Ключ видалено.", "ok");
    }

    private async Task TestKey(AiProvider provider)
    {
        _testing = true;
        StateHasChanged();
        try
        {
            var key = await AiSettings.GetApiKeyAsync(provider);
            var config = new AiProviderConfig(provider, AiSettings.GetModel(provider), key!);
            var client = ChatClientFactory.Create(config, withFunctionInvocation: false);
            var response = await client.GetResponseAsync(
                [new ChatMessage(ChatRole.User, "Відповідай одним словом: працює")],
                new ChatOptions { MaxOutputTokens = 20 });
            Notify($"✓ Ключ працює. Відповідь моделі: {response.Text}", "ok");
        }
        catch (Exception ex)
        {
            Notify($"✗ Перевірка не вдалася: {ex.Message}", "error");
        }
        finally
        {
            _testing = false;
        }
    }

    private Task SaveTranscription()
    {
        if (Enum.TryParse<AiProvider>(_transcriptionProvider, out var p))
            AiSettings.TranscriptionProvider = p;
        return Task.CompletedTask;
    }

    private Task SaveSendOnEnter()
    {
        AiSettings.SendOnEnter = _sendOnEnter == "true";
        Notify("Збережено. Зміна діятиме при наступному відкритті чату.", "ok");
        return Task.CompletedTask;
    }

    private void ToggleRealNames(ChangeEventArgs e)
    {
        _showRealNames = (bool)e.Value!;
        AiSettings.ShowRealNamesInChat = _showRealNames;
        Notify(_showRealNames
            ? "Увага: реальні імена учнів тепер передаються AI-провайдеру."
            : "Псевдоніми ввімкнено — ПІБ учнів не залишають цей компʼютер.", _showRealNames ? "warn" : "ok");
    }

    private async Task ClearCache()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        db.Journals.RemoveRange(db.Journals);
        db.Students.RemoveRange(db.Students);
        db.Lessons.RemoveRange(db.Lessons);
        db.Marks.RemoveRange(db.Marks);
        db.Homework.RemoveRange(db.Homework);
        db.LessonForms.RemoveRange(db.LessonForms);
        db.PendingOps.RemoveRange(db.PendingOps);
        await db.SaveChangesAsync();
        _clearCacheVisible = false;
        _dbSize = GetDbSize();
        Notify("Збережені журнали видалено.", "ok");
    }

    /// <summary>Розмір бази включно з WAL/SHM; до 1 МБ показуємо в КБ.</summary>
    private static string GetDbSize()
    {
        try
        {
            long bytes = 0;
            var path = NzuaTeacher.Core.AppPaths.DbPath;
            foreach (var f in new[] { path, path + "-wal", path + "-shm" })
            {
                var info = new FileInfo(f);
                if (info.Exists) bytes += info.Length;
            }
            if (bytes == 0) return "порожньо";
            return bytes < 1024 * 1024
                ? $"{Math.Max(1, bytes / 1024)} КБ"
                : $"{bytes / 1024.0 / 1024.0:0.0} МБ";
        }
        catch
        {
            return "—";
        }
    }

    private static string ProviderIcon(AiProvider p) => p switch
    {
        AiProvider.Gemini => "🔷",
        AiProvider.OpenAi => "🟢",
        AiProvider.Anthropic => "🟠",
        _ => "🤖",
    };

    private void Notify(string text, string cls)
    {
        _notice = text;
        _noticeClass = cls;
    }
}
