@implements IAsyncDisposable
@using NzuaTeacher.Services
@inject IJSRuntime JS

<div id="@_elementId" class="@CssClass">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = "drop-zone";
    [Parameter] public EventCallback<IReadOnlyList<BrowserFile>> OnFiles { get; set; }

    private readonly string _elementId = $"dz-{Guid.NewGuid():N}";
    private DotNetObjectReference<DropZone>? _ref;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _ref = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("nzuaAttachments.register", _elementId, _ref);
        }
        catch (Exception ex)
        {
            // Без вставки/перетягування сторінка має працювати далі — кнопка вибору файлів лишається.
            FileLoggerProvider.Write("DropZone", "Не вдалося увімкнути вставку/перетягування файлів", ex);
        }
    }

    [JSInvokable]
    public Task OnFilesFromBrowser(BrowserFile[] files) => OnFiles.InvokeAsync(files);

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("nzuaAttachments.unregister", _elementId);
        }
        catch
        {
            // сторінку вже закрито або скрипт недоступний
        }
        _ref?.Dispose();
    }
}
